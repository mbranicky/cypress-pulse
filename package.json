{
  "name": "cypress-pulse",
  "private": true,
  "version": "0.4.0",
  "description": "A standalone Cypress run dashboard for Paseo",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "bin": {
    "cypress-pulse": "server/cli.mjs"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "README.md",
    "LICENSE",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "skills/",
    "!**/*.test.mjs",
    "assets/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cypress/webpack-preprocessor": "7.1.1",
    "@getpaseo/plugin": "0.11.2",
    "@tanstack/react-query": "5.104.2",
    "@types/node": "24.0.0",
    "@types/react": "19.2.18",
    "cypress": "16.1.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "ts-loader": "9.5.7",
    "typescript": "5.9.3",
    "webpack": "5.106.2",
    "zod": "4.6.7"
  }
}
