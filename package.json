{
  "name": "paseo-cypress-pulse",
  "version": "1.3.0",
  "description": "A standalone Cypress run dashboard for Paseo",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "bin": {
    "cypress-pulse": "server/cli.mjs"
  },
  "files": [
    "paseo-plugin.json",
    "npm-shrinkwrap.json",
    "OVERVIEW.md",
    "README.md",
    "RELEASE_NOTES.md",
    "RELEASING.md",
    "LICENSE",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "skills/",
    "!**/*.test.mjs",
    "assets/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:paseo-012": "node scripts/check-paseo-sdk.mjs",
    "typecheck:paseo-013": "node scripts/check-paseo-sdk.mjs 0.13.0",
    "typecheck:paseo-014": "node scripts/check-paseo-sdk.mjs 0.14.0",
    "test": "node --test server/*.test.mjs",
    "test:publishing": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "test:integration": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "pack:release": "node scripts/package.mjs",
    "test:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@cypress/webpack-preprocessor": "7.1.1",
    "@getpaseo/plugin": "0.11.2",
    "@tanstack/react-query": "5.104.2",
    "@types/node": "24.0.0",
    "@types/react": "19.2.18",
    "cypress": "16.1.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "ts-loader": "9.5.7",
    "webpack": "5.106.2",
    "zod": "4.6.7"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbranicky/cypress-pulse.git"
  },
  "homepage": "https://github.com/mbranicky/cypress-pulse#readme",
  "bugs": {
    "url": "https://github.com/mbranicky/cypress-pulse/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
