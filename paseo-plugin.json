{
  "id": "cypress-pulse",
  "name": "Cypress Pulse",
  "description": "Live Cypress run progress and failures alongside your Paseo agents.",
  "requirements": {
    "paseo": ">=0.11.2 <0.14.0"
  },
  "media": [
    "assets/running.png",
    "assets/failure.png",
    "assets/skill-setup.png",
    "assets/light.png",
    "assets/source-preview.png",
    "assets/screenshot-preview.png",
    "assets/settings.png",
    "assets/video-preview.png",
    "assets/test-details.png",
    "assets/logs.png"
  ],
  "build": [
    [
      "npm",
      "ci",
      "--omit=dev",
      "--ignore-scripts"
    ]
  ]
}
